[options]
mode prove
depth 30
wait on

[engines]
smtbmc z3

[script]
read -formal -sv aes_sbox.sv
read -formal -sv aes_inv_sbox.sv
read -formal -sv aes_rcon.sv
read -formal -sv aes_round.sv
read -formal -sv aes_inv_round.sv
read -formal -sv aes_key_expand_256.sv
read -formal -sv aes_core.sv
read -formal -sv gf_mul128.sv
read -formal -sv ghash_core.sv
read -formal -sv aes_gcm_top.sv
read -formal -sv keccak_round_constants.sv
read -formal -sv keccak_round.sv
read -formal -sv keccak_f1600.sv
read -formal -sv sha3_core.sv
read -formal -sv rot_top.sv
read -formal -sv rot_formal_props.sv
read -formal -sv rot_formal_wrapper.sv
prep -top rot_formal_wrapper

[files]
../../rtl/aes/aes_sbox.sv
../../rtl/aes/aes_inv_sbox.sv
